{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/manuscript.schema.json",
  "title": "Module04CompleteManuscript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module04_run_id", "markdown", "evidence_ids"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "module04_run_id": { "type": "string", "minLength": 1 },
    "markdown": { "type": "string", "minLength": 10000 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
