{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/manuscript-evaluation.schema.json",
  "title": "Module05ManuscriptEvaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module05_run_id",
    "overall_assessment",
    "dimensions",
    "priority_revisions",
    "revision_strategy"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "module05_run_id": { "type": "string", "minLength": 1 },
    "overall_assessment": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_perspective", "differentiation", "logic", "completeness"],
      "properties": {
        "review_perspective": { "$ref": "#/$defs/dimension" },
        "differentiation": { "$ref": "#/$defs/dimension" },
        "logic": { "$ref": "#/$defs/dimension" },
        "completeness": { "$ref": "#/$defs/dimension" }
      }
    },
    "priority_revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "location", "problem", "change_instruction", "success_criterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
          "priority": { "enum": ["high", "medium", "low"] },
          "location": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "change_instruction": { "type": "string", "minLength": 1 },
          "success_criterion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revision_strategy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "strengths", "weaknesses", "evidence", "required_changes"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "weaknesses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
