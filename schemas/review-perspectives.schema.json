{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/review-perspectives.schema.json",
  "title": "Module02ReviewPerspectives",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module02_run_id", "perspectives"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "module02_run_id": { "type": "string", "minLength": 1 },
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "candidate_title", "central_question", "supporting_review_ids", "supporting_paper_ids", "similarities", "differences", "recommended_scope", "risks"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "candidate_title": { "type": "string", "minLength": 1 },
          "central_question": { "type": "string", "minLength": 1 },
          "supporting_review_ids": { "type": "array", "items": { "type": "string" } },
          "supporting_paper_ids": { "type": "array", "items": { "type": "string" } },
          "similarities": { "type": "array", "items": { "type": "string" } },
          "differences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "recommended_scope": { "type": "string", "minLength": 1 },
          "risks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
