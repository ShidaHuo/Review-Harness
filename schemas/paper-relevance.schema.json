{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/paper-relevance.schema.json",
  "title": "Module01PaperRelevanceBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_run_id", "papers"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "topic_run_id": { "type": "string", "minLength": 1 },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "label", "confidence", "reason", "actor"],
        "properties": {
          "paper_id": { "type": "string", "minLength": 1 },
          "label": { "enum": ["direct", "technical", "excluded", "uncertain"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "reason": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
