{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/perspective-selection.schema.json",
  "title": "Module02AutomaticPerspectiveSelection",
  "type": "object",
  "additionalProperties": false,
  "required": ["module02_run_id", "criterion", "candidates", "recommended_rank", "message"],
  "properties": {
    "module02_run_id": { "type": "string", "minLength": 1 },
    "criterion": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "label",
          "weighted_score",
          "differentiation_score",
          "completeness_score",
          "maturity_score",
          "selection_rationale",
          "branch_status",
          "module03_run_id"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "label": { "type": "string", "minLength": 1 },
          "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "differentiation_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "completeness_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "maturity_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "selection_rationale": { "type": "string", "minLength": 1 },
          "branch_status": { "type": "string", "minLength": 1 },
          "module03_run_id": { "type": ["string", "null"] }
        }
      }
    },
    "recommended_rank": { "type": "integer", "minimum": 1, "maximum": 5 },
    "message": { "type": "string", "minLength": 1 }
  }
}
