{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/decision.schema.json",
  "title": "TopicDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent_recommendation", "user_decision", "decided_at"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "agent_recommendation": { "enum": ["recommended", "reframe_required", "insufficient_evidence", "not_recommended", "pending"] },
    "user_decision": { "enum": ["approved", "rejected"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "frozen_topic_profile_hash": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "module_02_permitted": { "type": "boolean" }
  }
}
