{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/manuscript-revision.schema.json",
  "title": "Module05ManuscriptRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module05_run_id", "revised_markdown", "addressed_revision_ids", "change_log"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "module05_run_id": { "type": "string", "minLength": 1 },
    "revised_markdown": { "type": "string", "minLength": 8000 },
    "addressed_revision_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
      "uniqueItems": true
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision_id", "location", "change_summary"],
        "properties": {
          "revision_id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
          "location": { "type": "string", "minLength": 1 },
          "change_summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
