{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-harness.local/schemas/review-outline.schema.json",
  "title": "Module03ReviewOutline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module03_run_id",
    "candidate_title",
    "title_rationale",
    "organizing_principle",
    "intended_audience",
    "scope_statement",
    "sections"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "module03_run_id": { "type": "string", "minLength": 1 },
    "candidate_title": { "type": "string", "minLength": 1 },
    "title_rationale": { "type": "string", "minLength": 1 },
    "organizing_principle": { "type": "string", "minLength": 1 },
    "intended_audience": { "type": "string", "minLength": 1 },
    "scope_statement": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "level",
          "purpose",
          "writing_logic",
          "rationale",
          "key_questions",
          "evidence_ids",
          "expected_takeaway",
          "transition"
        ],
        "properties": {
          "number": { "type": "string", "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*){0,3}$" },
          "title": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 4 },
          "purpose": { "type": "string", "minLength": 1 },
          "writing_logic": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "key_questions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "expected_takeaway": { "type": "string", "minLength": 1 },
          "transition": { "type": ["string", "null"] }
        }
      }
    }
  }
}
